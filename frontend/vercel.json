{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/gas-station/browser",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://gas-station-backend-p2kq.onrender.com/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
